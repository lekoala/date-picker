{
  "name": "@lekoala/date-picker",
  "version": "0.1.1",
  "description": "Native-first date picker and inline calendar primitives",
  "type": "module",
  "sideEffects": [
    "./src/define.js",
    "./src/date-picker.css",
    "./dist/date-picker.js",
    "./dist/date-picker.min.js",
    "./dist/date-picker.standalone.min.js",
    "./dist/date-picker.css",
    "./dist/date-picker.min.css"
  ],
  "license": "MIT",
  "customElements": "custom-elements.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekoala/date-picker.git"
  },
  "homepage": "https://github.com/lekoala/date-picker",
  "bugs": "https://github.com/lekoala/date-picker/issues",
  "packageManager": "bun@1.4.2",
  "keywords": [
    "date-picker",
    "calendar",
    "datepicker",
    "popover",
    "web-component",
    "accessibility"
  ],
  "files": [
    "dist",
    "src",
    "docs",
    "custom-elements.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.js"
    },
    "./define": {
      "types": "./dist/types/define.d.ts",
      "import": "./src/define.js"
    },
    "./calendar": {
      "types": "./dist/types/date-calendar.d.ts",
      "import": "./src/date-calendar.js"
    },
    "./date-picker.css": "./src/date-picker.css",
    "./locales/ar": {
      "types": "./dist/types/locales/ar.d.ts",
      "import": "./src/locales/ar.js"
    },
    "./locales/de": {
      "types": "./dist/types/locales/de.d.ts",
      "import": "./src/locales/de.js"
    },
    "./locales/en": {
      "types": "./dist/types/locales/en.d.ts",
      "import": "./src/locales/en.js"
    },
    "./locales/es": {
      "types": "./dist/types/locales/es.d.ts",
      "import": "./src/locales/es.js"
    },
    "./locales/fr": {
      "types": "./dist/types/locales/fr.d.ts",
      "import": "./src/locales/fr.js"
    },
    "./locales/hi": {
      "types": "./dist/types/locales/hi.d.ts",
      "import": "./src/locales/hi.js"
    },
    "./locales/id": {
      "types": "./dist/types/locales/id.d.ts",
      "import": "./src/locales/id.js"
    },
    "./locales/it": {
      "types": "./dist/types/locales/it.d.ts",
      "import": "./src/locales/it.js"
    },
    "./locales/ja": {
      "types": "./dist/types/locales/ja.d.ts",
      "import": "./src/locales/ja.js"
    },
    "./locales/ko": {
      "types": "./dist/types/locales/ko.d.ts",
      "import": "./src/locales/ko.js"
    },
    "./locales/nl": {
      "types": "./dist/types/locales/nl.d.ts",
      "import": "./src/locales/nl.js"
    },
    "./locales/pl": {
      "types": "./dist/types/locales/pl.d.ts",
      "import": "./src/locales/pl.js"
    },
    "./locales/pt-BR": {
      "types": "./dist/types/locales/pt-BR.d.ts",
      "import": "./src/locales/pt-BR.js"
    },
    "./locales/pt-PT": {
      "types": "./dist/types/locales/pt-PT.d.ts",
      "import": "./src/locales/pt-PT.js"
    },
    "./locales/ru": {
      "types": "./dist/types/locales/ru.d.ts",
      "import": "./src/locales/ru.js"
    },
    "./locales/tr": {
      "types": "./dist/types/locales/tr.d.ts",
      "import": "./src/locales/tr.js"
    },
    "./locales/zh-CN": {
      "types": "./dist/types/locales/zh-CN.d.ts",
      "import": "./src/locales/zh-CN.js"
    },
    "./standalone": "./dist/date-picker.standalone.min.js",
    "./dist/date-picker.js": "./dist/date-picker.js",
    "./dist/date-picker.min.js": "./dist/date-picker.min.js",
    "./dist/date-picker.standalone.min.js": "./dist/date-picker.standalone.min.js",
    "./dist/date-picker.css": "./dist/date-picker.css",
    "./dist/date-picker.min.css": "./dist/date-picker.min.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node test/server.js",
    "dev:kill": "node scripts/kill-port.mjs",
    "dev:restart": "node scripts/kill-port.mjs && node test/server.js",
    "build:bundle": "bun scripts/build.js",
    "build:types": "bun run types",
    "build:manifest": "bun scripts/custom-elements.js",
    "build": "bun run build:bundle && bun run build:types && bun run build:manifest",
    "sync": "bun run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p jsconfig.json",
    "types": "tsc -p tsconfig.types.json",
    "test": "bun test test/unit",
    "test:syntax": "node --check src/date.js && node --check src/intl.js && node --check src/calendar-model.js && node --check src/source.js && node --check src/messages.js && node --check src/date-calendar.js && node --check src/date-field.js && node --check src/date-picker.js && node --check src/date-range.js && node --check src/time.js && node --check src/index.js && node --check src/define.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:browser": "playwright test browser --project chromium",
    "test:browser:accessibility": "playwright test test/browser/picker.spec.js test/browser/focus.spec.js test/browser/calendar.spec.js test/browser/form-state.spec.js test/browser/surfaces.spec.js",
    "test:browser:headed": "playwright test browser --project chromium --headed",
    "test:browser:all": "playwright test browser",
    "test:dist": "playwright test dist --project chromium",
    "shot:forced-colors": "bun scripts/forced-colors-shot.js",
    "shot:forced-colors:important": "bun scripts/forced-colors-shot.js /demo/index.html --scenario important --out-dir tmp/forced-colors-important",
    "shot:forced-colors:important:dark": "bun scripts/forced-colors-shot.js /demo/index.html --scheme dark --scenario important --out-dir tmp/forced-colors-important-dark",
    "check": "bun run test:syntax && bun run lint && bun run typecheck && bun run test",
    "verify": "bun run check && bun run sync && bun run test:types && bun run check:generated && bun run check:package",
    "check:all": "bun run verify && bun run test:browser:all && bun run test:dist",
    "check:generated": "bun scripts/check-generated.js",
    "check:package": "bun scripts/check-package.js",
    "prepack": "bun run sync",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@lekoala/calendar": "0.1.0",
    "@playwright/test": "1.62.1",
    "temporal-polyfill": "^1.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@lekoala/floating": "^0.1.1"
  }
}

{
  "name": "@lekoala/date-picker",
  "version": "0.0.0",
  "description": "Native-first date picker and inline calendar primitives",
  "type": "module",
  "sideEffects": [
    "./src/define.js",
    "./src/date-picker.css",
    "./dist/date-picker.js",
    "./dist/date-picker.min.js",
    "./dist/date-picker.standalone.min.js",
    "./dist/date-picker.css",
    "./dist/date-picker.min.css"
  ],
  "license": "MIT",
  "customElements": "custom-elements.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekoala/date-picker.git"
  },
  "homepage": "https://github.com/lekoala/date-picker",
  "bugs": "https://github.com/lekoala/date-picker/issues",
  "packageManager": "bun@1.4.2",
  "keywords": [
    "date-picker",
    "calendar",
    "datepicker",
    "popover",
    "web-component",
    "accessibility"
  ],
  "files": [
    "dist",
    "src",
    "docs",
    "custom-elements.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.js"
    },
    "./define": {
      "types": "./dist/types/define.d.ts",
      "import": "./src/define.js"
    },
    "./calendar": {
      "types": "./dist/types/date-calendar.d.ts",
      "import": "./src/date-calendar.js"
    },
    "./date-picker.css": "./src/date-picker.css",
    "./locales/fr": {
      "types": "./dist/types/locales/fr.d.ts",
      "import": "./src/locales/fr.js"
    },
    "./standalone": "./dist/date-picker.standalone.min.js",
    "./dist/date-picker.js": "./dist/date-picker.js",
    "./dist/date-picker.min.js": "./dist/date-picker.min.js",
    "./dist/date-picker.standalone.min.js": "./dist/date-picker.standalone.min.js",
    "./dist/date-picker.css": "./dist/date-picker.css",
    "./dist/date-picker.min.css": "./dist/date-picker.min.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node test/server.js",
    "build:bundle": "bun scripts/build.js",
    "build:types": "bun run types",
    "build:manifest": "bun scripts/custom-elements.js",
    "build": "bun run build:bundle && bun run build:types && bun run build:manifest",
    "sync": "bun run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p jsconfig.json",
    "types": "tsc -p tsconfig.types.json",
    "test": "bun test test/unit",
    "test:syntax": "node --check src/date.js && node --check src/intl.js && node --check src/calendar-model.js && node --check src/source.js && node --check src/messages.js && node --check src/date-calendar.js && node --check src/date-picker.js && node --check src/date-range.js && node --check src/index.js && node --check src/define.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:browser": "playwright test browser --project chromium",
    "test:browser:headed": "playwright test browser --project chromium --headed",
    "test:browser:all": "playwright test browser",
    "test:dist": "playwright test dist --project chromium",
    "check": "bun run test:syntax && bun run lint && bun run typecheck && bun run test",
    "verify": "bun run check && bun run sync && bun run test:types && bun run check:generated && bun run check:package",
    "check:all": "bun run verify && bun run test:browser:all && bun run test:dist",
    "check:generated": "bun scripts/check-generated.js",
    "check:package": "bun scripts/check-package.js",
    "prepack": "bun run sync",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@lekoala/calendar": "0.1.0",
    "@playwright/test": "1.62.1",
    "temporal-polyfill": "^1.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@lekoala/floating": "^0.1.1"
  }
}
